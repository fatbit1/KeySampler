<https://github.com/keysampler/KeySampler>
    a lv2:InstrumentPlugin, lv2:Plugin ;
    doap:name "KeySampler" ;
    doap:maintainer [
        foaf:name "KeySampler" ;
    ] ;
    doap:license "MIT" ;
    lv2:minorVersion 35 ;
    lv2:microVersion 0 ;
    rdfs:comment "Records the bus input into slots and plays it chromatically from a MIDI keyboard." ;
    lv2:requiredFeature urid:map ;
    lv2:extensionData state:interface ;
    lv2:port
    [
        a lv2:InputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:designation lv2:control ;
        lv2:index 0 ;
        lv2:symbol "events" ;
        lv2:name "Events" ;
    ] ,
    [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "audio_out_l" ;
        lv2:name "Audio Output Left" ;
    ] ,
