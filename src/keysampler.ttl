        lv2:name "Attack ms" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 2000.0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 14 ;
        lv2:symbol "decay" ;
        lv2:name "Decay ms" ;
        lv2:default 200.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 5000.0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 15 ;
        lv2:symbol "sustain" ;
        lv2:name "Sustain" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] ,
