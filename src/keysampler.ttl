        lv2:symbol "fenv_attack" ;
        lv2:name "F.Env Attack ms" ;
        lv2:default 5.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 2000.0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 28 ;
        lv2:symbol "fenv_decay" ;
        lv2:name "F.Env Decay ms" ;
        lv2:default 300.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 5000.0 ;
    ] ,
    [
