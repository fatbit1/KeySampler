        lv2:index 29 ;
        lv2:symbol "fenv_sustain" ;
        lv2:name "F.Env Sustain" ;
        lv2:default 0.2 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 30 ;
        lv2:symbol "fenv_release" ;
        lv2:name "F.Env Release ms" ;
        lv2:default 300.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 5000.0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 31 ;
        lv2:symbol "glide_mode" ;
        lv2:name "Glide Mode" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
