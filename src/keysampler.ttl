                       [ rdfs:label "Record" ; rdf:value 13 ] ,
                       [ rdfs:label "Filter Type" ; rdf:value 14 ] ,
                       [ rdfs:label "Mode" ; rdf:value 15 ] ,
                       [ rdfs:label "Pan" ; rdf:value 16 ] ,
                       [ rdfs:label "Vib Rate" ; rdf:value 17 ] ,
                       [ rdfs:label "Vib Depth" ; rdf:value 18 ] ,
                       [ rdfs:label "Vib Delay" ; rdf:value 19 ] ,
                       [ rdfs:label "Thru" ; rdf:value 20 ] ,
                       [ rdfs:label "Glide Mode" ; rdf:value 21 ] ,
                       [ rdfs:label "Glide Time" ; rdf:value 22 ] ,
                       [ rdfs:label "Filter Env" ; rdf:value 23 ] ,
                       [ rdfs:label "F.Env Amount" ; rdf:value 24 ] ,
                       [ rdfs:label "F.Env Attack" ; rdf:value 25 ] ,
                       [ rdfs:label "F.Env Decay" ; rdf:value 26 ] ,
                       [ rdfs:label "F.Env Sustain" ; rdf:value 27 ] ,
                       [ rdfs:label "F.Env Release" ; rdf:value 28 ] ,
                       [ rdfs:label "Save to Menu" ; rdf:value 29 ] ,
                       [ rdfs:label "Restore Menu" ; rdf:value 30 ] ,
                       [ rdfs:label "Reset Map" ; rdf:value 31 ] ;
    ] ,
    [
