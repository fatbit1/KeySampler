        lv2:symbol "audio_in_l" ;
        lv2:name "Audio Input Left" ;
    ] ,
    [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 4 ;
        lv2:symbol "audio_in_r" ;
        lv2:name "Audio Input Right" ;
    ] ,
    [
