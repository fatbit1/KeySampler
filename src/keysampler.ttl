        lv2:maximum 5000.0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 17 ;
        lv2:symbol "start_sec" ;
        lv2:name "Start sec" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 59 ;
        lv2:portProperty lv2:integer ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 18 ;
        lv2:symbol "start_msec" ;
        lv2:name "Start ms" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 999 ;
        lv2:portProperty lv2:integer ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 19 ;
        lv2:symbol "loop_start_sec" ;
        lv2:name "Loop Start sec" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 59 ;
        lv2:portProperty lv2:integer ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 20 ;
        lv2:symbol "loop_start_msec" ;
        lv2:name "Loop Start ms" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 999 ;
        lv2:portProperty lv2:integer ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
